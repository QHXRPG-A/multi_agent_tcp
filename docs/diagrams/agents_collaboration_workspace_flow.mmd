flowchart TB
    user["用户 / 桌面界面\n提出目标、查看进展"]
    top["总控 Agent\n理解目标、拆解任务、解释状态"]
    fw["框架调度与消息中心\n校验计划、排队投递、等待汇合、记录事件"]

    a["Agent A\n处理一个子任务"]
    b["Agent B\n并行处理另一个子任务"]
    r["汇总 / 评审 Agent\n接收框架整理后的汇总包"]

    p["每个 Agent 的私有工作区\n私有代码检出 / 授权规则与技能 / 上下文令牌"]
    s["本次运行的临时共享工作区\n统一合并代码 / 保存报告产物 / 记录变更冲突"]
    z["长期归档\n完成后保存报告、产物、变更和冲突"]

    user -->|"目标 / 追问"| top
    top -->|"计划 / 状态请求"| fw
    fw -->|"下发任务与上下文"| a
    fw -->|"下发任务与上下文"| b
    a -->|"提交消息意图 / 完成回执"| fw
    b -->|"提交消息意图 / 完成回执"| fw
    fw -->|"汇总后投递"| r

    a -->|"私有修改"| p
    b -->|"私有修改"| p
    p -->|"提交变更 / 发布报告产物"| s
    s -->|"共享结果进入汇总"| r
    s -->|"收口归档"| z
