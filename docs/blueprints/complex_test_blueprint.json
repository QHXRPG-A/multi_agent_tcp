{
  "schema_version": 1,
  "name": "complex_test_blueprint",
  "description": "Machine-readable fixture paired with complex_test_blueprint.svg for GuLiCode and GraphRuntime scheduling tests.",
  "source_svg": "docs/blueprints/complex_test_blueprint.svg",
  "graph": {
    "terminal_nodes": {
      "start": "start",
      "end": "end"
    },
    "agent_nodes": {
      "requirements": {
        "agent_id": "agent-requirements",
        "prompt": "Break down the user goal and dispatch risk, architecture, and test-planning work.",
        "read_scope": ["docs/**"],
        "write_scope": ["shared/reports/**"],
        "artifact_scope": ["shared/artifacts/**"]
      },
      "risk_scan": {
        "agent_id": "agent-risk-scan",
        "prompt": "Scan the plan for security and release risk.",
        "write_scope": ["shared/reports/risk/**"]
      },
      "architecture": {
        "agent_id": "agent-architecture",
        "prompt": "Produce the implementation architecture and split backend/frontend work.",
        "write_scope": ["shared/reports/architecture/**"]
      },
      "test_planner": {
        "agent_id": "agent-test-planner",
        "prompt": "Plan unit and end-to-end test coverage.",
        "write_scope": ["shared/reports/testing/**"]
      },
      "backend_impl": {
        "agent_id": "agent-backend-impl",
        "prompt": "Implement backend changes.",
        "write_scope": ["src/backend/**"],
        "artifact_scope": ["shared/artifacts/backend/**"]
      },
      "frontend_impl": {
        "agent_id": "agent-frontend-impl",
        "prompt": "Implement frontend changes.",
        "write_scope": ["src/frontend/**"],
        "artifact_scope": ["shared/artifacts/frontend/**"]
      },
      "unit_tests": {
        "agent_id": "agent-unit-tests",
        "prompt": "Run and report unit tests.",
        "artifact_scope": ["shared/artifacts/tests/unit/**"]
      },
      "e2e_tests": {
        "agent_id": "agent-e2e-tests",
        "prompt": "Run and report end-to-end tests.",
        "artifact_scope": ["shared/artifacts/tests/e2e/**"]
      },
      "security_review": {
        "agent_id": "agent-security-review",
        "prompt": "Review high-risk changes before regular review.",
        "write_scope": ["shared/reports/security/**"]
      },
      "review": {
        "agent_id": "agent-review",
        "prompt": "Review implementation, test, and risk outputs.",
        "write_scope": ["shared/reports/review/**"]
      },
      "patch": {
        "agent_id": "agent-patch",
        "prompt": "Patch review or integration failures.",
        "write_scope": ["src/**"],
        "artifact_scope": ["shared/artifacts/patch/**"]
      },
      "integration": {
        "agent_id": "agent-integration",
        "prompt": "Validate integrated changes and retry when needed.",
        "artifact_scope": ["shared/artifacts/integration/**"]
      },
      "failure_analysis": {
        "agent_id": "agent-failure-analysis",
        "prompt": "Classify integration failure and send retry guidance.",
        "write_scope": ["shared/reports/failures/**"]
      },
      "summary": {
        "agent_id": "agent-summary",
        "prompt": "Summarize the run and prepare archive records.",
        "write_scope": ["shared/reports/**"]
      },
      "event_monitor": {
        "agent_id": "agent-event-monitor",
        "prompt": "Collect runtime events as a side channel.",
        "write_scope": ["shared/reports/events/**"]
      },
      "workspace_state": {
        "agent_id": "agent-workspace-state",
        "prompt": "Collect workspace state as a side channel.",
        "write_scope": ["shared/reports/workspace/**"]
      }
    },
    "edges": [
      {"from": "start", "to": "requirements", "edge_type": "exec"},
      {"from": "requirements", "to": "risk_scan", "edge_type": "exec"},
      {"from": "requirements", "to": "architecture", "edge_type": "exec"},
      {"from": "requirements", "to": "test_planner", "edge_type": "exec"},
      {"from": "architecture", "to": "backend_impl", "edge_type": "exec"},
      {"from": "architecture", "to": "frontend_impl", "edge_type": "exec"},
      {"from": "test_planner", "to": "unit_tests", "edge_type": "exec"},
      {"from": "test_planner", "to": "e2e_tests", "edge_type": "exec"},
      {"from": "risk_scan", "to": "security_review", "edge_type": "exec", "output_port": "high_risk"},
      {"from": "risk_scan", "to": "review", "edge_type": "condition_low_medium"},
      {"from": "security_review", "to": "review", "edge_type": "exec"},
      {"from": "backend_impl", "to": "review", "edge_type": "exec"},
      {"from": "frontend_impl", "to": "review", "edge_type": "exec"},
      {"from": "review", "to": "patch", "edge_type": "condition_review_failed"},
      {"from": "review", "to": "integration", "edge_type": "exec"},
      {"from": "patch", "to": "integration", "edge_type": "exec"},
      {"from": "unit_tests", "to": "integration", "edge_type": "exec"},
      {"from": "e2e_tests", "to": "integration", "edge_type": "exec"},
      {"from": "integration", "to": "failure_analysis", "edge_type": "retry"},
      {"from": "integration", "to": "summary", "edge_type": "exec"},
      {"from": "summary", "to": "end", "edge_type": "exec"},
      {"from": "requirements", "to": "event_monitor", "edge_type": "side_channel"},
      {"from": "backend_impl", "to": "workspace_state", "edge_type": "side_channel"},
      {"from": "frontend_impl", "to": "workspace_state", "edge_type": "side_channel"},
      {"from": "unit_tests", "to": "workspace_state", "edge_type": "side_channel"},
      {"from": "e2e_tests", "to": "workspace_state", "edge_type": "side_channel"}
    ]
  },
  "top_agent_start_plan": {
    "user_goal": "Run the fixed complex blueprint test task from planning through archive.",
    "agent_descriptions": {
      "requirements": "Breaks down the user goal and fans out required work.",
      "risk_scan": "Scans requirements and architecture for risk level.",
      "architecture": "Creates implementation architecture and splits backend/frontend work.",
      "test_planner": "Creates the unit and end-to-end testing strategy.",
      "backend_impl": "Produces backend changes and artifacts.",
      "frontend_impl": "Produces frontend changes and artifacts.",
      "unit_tests": "Runs unit tests and publishes test results.",
      "e2e_tests": "Runs end-to-end tests and publishes test results.",
      "security_review": "Reviews high-risk paths before regular review.",
      "review": "Aggregates implementation, risk, and test inputs for review.",
      "patch": "Fixes review or integration failures and feeds retry work.",
      "integration": "Validates integrated changes and decides success or failure attribution.",
      "failure_analysis": "Classifies integration failure and produces retry guidance.",
      "summary": "Builds the final report and archive summary.",
      "event_monitor": "Collects side-channel runtime events.",
      "workspace_state": "Collects side-channel workspace state."
    },
    "start_nodes": ["requirements"],
    "tasks": {
      "requirements": {
        "goal": "Analyze the user goal and dispatch risk, architecture, and test-planning tasks through framework messaging.",
        "expected_output": "A complete outgoing batch for risk_scan, architecture, and test_planner.",
        "acceptance": "Every required downstream target receives a framework-queued message and the message journal is persisted."
      }
    },
    "run_policy": {
      "allow_parallel": true,
      "persist_message_io": true,
      "archive_on_complete": true
    }
  },
  "runtime_scenarios": {
    "decisions": {
      "risk": "high",
      "review": "failed_once",
      "integration": "failed_once",
      "max_integration_retries": 1
    },
    "joins": [
      {
        "join_id": "join-implementation-ready",
        "policy": "wait-all",
        "required_sources": ["backend_impl", "frontend_impl"],
        "target": "review"
      },
      {
        "join_id": "join-test-ready",
        "policy": "wait-all",
        "required_sources": ["unit_tests", "e2e_tests"],
        "target": "integration"
      },
      {
        "join_id": "join-review-and-tests",
        "policy": "quorum",
        "quorum": 2,
        "required_sources": ["review", "unit_tests", "e2e_tests"],
        "target": "integration"
      }
    ],
    "conditional_routes": [
      {
        "from": "risk_scan",
        "condition": "risk == high",
        "to": "security_review"
      },
      {
        "from": "risk_scan",
        "condition": "risk in ['low', 'medium']",
        "to": "review"
      },
      {
        "from": "review",
        "condition": "review == failed",
        "to": "patch"
      }
    ],
    "retry_routes": [
      {
        "from": "integration",
        "condition": "integration == failed",
        "to": "failure_analysis"
      },
      {
        "from": "failure_analysis",
        "condition": "retry_allowed",
        "to": "patch"
      }
    ],
    "side_channels": [
      "event_monitor",
      "workspace_state"
    ],
    "persistence": {
      "message_journal": "shared/logs/message_journal.jsonl",
      "final_report": "shared/reports/final_report.json"
    }
  }
}
